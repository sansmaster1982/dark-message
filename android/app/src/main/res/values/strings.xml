    <!-- Detailed instructions in Settings -->
    <string name="settings_instr_title">Detailed instructions</string>
    <string name="settings_instr_overview_title">What is Dark Message?</string>
    <string name="settings_instr_overview">Dark Message is a fully offline app for encrypting messages, photos, and documents. It does not require internet access and never transmits any data. You encrypt content locally, then send the encrypted text or file through any messenger or email. The recipient decrypts it in the same app using the same passphrase.</string>

    <string name="settings_instr_step1_title">Step 1: Create a chat</string>
    <string name="settings_instr_step1_1">Open the \"Chats\" tab (first tab at the bottom).</string>
    <string name="settings_instr_step1_2">Press the + button in the bottom-right corner.</string>
    <string name="settings_instr_step1_3">Enter the contact name (e.g. \"Alice\").</string>
    <string name="settings_instr_step1_4">Enter a passphrase — a secret key that both you and your contact must know. You can type your own or press \"Generate key\" for a random secure key.</string>
    <string name="settings_instr_step1_5">Press \"Create\". The chat appears in the list.</string>
    <string name="settings_instr_step1_6">IMPORTANT: Share the passphrase with your contact in person or through a different secure channel. Both users must enter exactly the same passphrase.</string>

    <string name="settings_instr_step2_title">Step 2: Encrypt a message</string>
    <string name="settings_instr_step2_1">Go to the \"Encrypt\" tab (second tab).</string>
    <string name="settings_instr_step2_2">Select the chat from the dropdown at the top.</string>
    <string name="settings_instr_step2_3">Choose the content type: Text, Photo, or Document.</string>
    <string name="settings_instr_step2_4">For Text: type your message in the text field.</string>
    <string name="settings_instr_step2_5">For Photo: press \"Select image\" and pick a photo from your gallery.</string>
    <string name="settings_instr_step2_6">For Document: press \"Select document\" and pick any file (PDF, Word, Excel, etc.).</string>
    <string name="settings_instr_step2_7">Press the \"Encrypt\" button.</string>
    <string name="settings_instr_step2_8">For text: the encrypted message appears as Base64 text. Press \"Copy\" or the send button to share it via any messenger.</string>
    <string name="settings_instr_step2_9">For photos and documents: a .darkm file is created. Press \"Send .darkm file\" to share it through any app.</string>

    <string name="settings_instr_step3_title">Step 3: Send the encrypted message</string>
    <string name="settings_instr_step3_1">After encrypting text: press the send button (arrow icon) — the app chooser opens, select a messenger to send the encrypted text.</string>
    <string name="settings_instr_step3_2">After encrypting a photo or document: press \"Send .darkm file\" — the file chooser opens, send the .darkm file through any app.</string>
    <string name="settings_instr_step3_3">You can also copy the text manually and paste it into any chat.</string>

    <string name="settings_instr_step4_title">Step 4: Decrypt a message</string>
    <string name="settings_instr_step4_1">Go to the \"Decrypt\" tab (third tab).</string>
    <string name="settings_instr_step4_2">Select the chat from the dropdown (the same chat your contact used to encrypt).</string>
    <string name="settings_instr_step4_3">Choose \"Paste text\" or \"Import file\".</string>
    <string name="settings_instr_step4_4">For text: paste the encrypted Base64 text (use \"Paste from clipboard\" or paste manually).</string>
    <string name="settings_instr_step4_5">For files: press \"Select .darkm file\" and pick the received file.</string>
    <string name="settings_instr_step4_6">Press \"Decrypt\".</string>
    <string name="settings_instr_step4_7">The original message, photo, or document will appear. You can copy, save, or share the result.</string>

    <string name="settings_instr_tips_title">Tips</string>
    <string name="settings_instr_tip1">The longer the passphrase, the stronger the encryption. Use at least 8 characters or generate a random key.</string>
    <string name="settings_instr_tip2">The app uses AES-256-GCM encryption with PBKDF2-HMAC-SHA512 key derivation (600,000 iterations).</string>
    <string name="settings_instr_tip3">If decryption fails with \"Wrong passphrase\", make sure both users have the exact same passphrase.</string>
    <string name="settings_instr_tip4">To delete a chat, long-press it in the chat list and confirm.</string>
    <string name="settings_instr_tip5">The app has no internet permissions — your data never leaves your device unless you share it yourself.</string>

